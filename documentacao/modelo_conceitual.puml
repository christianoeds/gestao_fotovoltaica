@startchen modelo_conceitual
' Modelo conceitual (notação de Peter Chen): Gestão Fotovoltaica
' Para gerar a imagem: plugin PlantUML do PhpStorm.
'
' Leitura das cardinalidades: o par (mín,máx) ao lado de uma entidade indica
' com quantas instâncias DESSA entidade uma instância da outra se relaciona.
' Ex.: CLIENTE (1,1) — CONTRATA — (0,N) OBRA
'      → um cliente contrata de 0 a N obras; uma obra é contratada por 1 cliente.
'
' Especialização: linha dupla (=>=) = total; "d" = exclusiva (disjunta).

entity CIDADE {
  id <<key>>
  nome
  uf
}

entity PESSOA {
  id <<key>>
  nome
  telefone
  email
  endereco {
    logradouro
    numero
    bairro
  }
}

entity CLIENTE {
  cpfCnpj
}

entity ENGENHEIRO {
  crea
}

entity CONCESSIONARIA {
  id <<key>>
  nome
  sigla
  uf
}

entity FABRICANTE {
  id <<key>>
  nome
  paisOrigem
}

entity EQUIPAMENTO {
  id <<key>>
  tipo
  modelo
  potenciaW
  precoAtual
  garantiaAnos
}

entity OBRA {
  id <<key>>
  numeroUc
  enderecoInstalacao {
    logradouro
    numero
    bairro
  }
  tipoLigacao
  dataContrato
  valorContrato
  dataProtocolo
  dataAprovacao
  dataPrevista
  dataConclusao
  potenciaKwp <<derived>>
}

relationship MORA_EM {
}

relationship FICA_EM {
}

relationship CONTRATA {
}

relationship RESPONSAVEL_POR {
}

relationship CONECTA {
}

relationship FABRICA {
}

relationship UTILIZA {
  quantidade
  valorUnitario
}

' Generalização / especialização
PESSOA =>= d { CLIENTE, ENGENHEIRO }

' Relacionamentos
CIDADE -(1,1)- MORA_EM
MORA_EM -(0,N)- PESSOA

CIDADE -(1,1)- FICA_EM
FICA_EM -(0,N)- OBRA

CLIENTE -(1,1)- CONTRATA
CONTRATA -(0,N)- OBRA

ENGENHEIRO -(1,1)- RESPONSAVEL_POR
RESPONSAVEL_POR -(0,N)- OBRA

CONCESSIONARIA -(1,1)- CONECTA
CONECTA -(0,N)- OBRA

FABRICANTE -(1,1)- FABRICA
FABRICA -(0,N)- EQUIPAMENTO

OBRA -(0,N)- UTILIZA
UTILIZA -(0,N)- EQUIPAMENTO

@endchen
