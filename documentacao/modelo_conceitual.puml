@startchen modelo_conceitual
' Modelo conceitual (notação de Peter Chen): Gestão Fotovoltaica
' Para gerar a imagem: plugin PlantUML do PhpStorm.
'
' Leitura das cardinalidades: o par (mín,máx) ao lado de uma entidade indica
' com quantas instâncias DESSA entidade uma instância da outra se relaciona.
' Ex.: CLIENTE (1,1) — CONTRATA — (0,N) OBRA
'      → um cliente contrata de 0 a N obras; uma obra é contratada por 1 cliente.
'
' Especialização: linha dupla (=>=) = total; "d" = exclusiva (disjunta).

entity PESSOA {
  id <<key>>
  nome
  telefone
  email
  endereco {
    logradouro
    numero
    bairro
    cidade
    uf
  }
}

entity CLIENTE {
  cpf_cnpj
}

entity ENGENHEIRO {
  crea
}

entity COLABORADOR {
  cpf
  funcao
}

entity CONCESSIONARIA {
  id <<key>>
  nome
  sigla
  uf
}

entity EQUIPE {
  id <<key>>
  nome
}

entity FABRICANTE {
  id <<key>>
  nome
  pais_origem
}

entity EQUIPAMENTO {
  id <<key>>
  tipo
  modelo
  potencia_w
  preco_atual
  garantia_anos
}

entity ETAPA {
  id <<key>>
  nome
  ordem
}

entity OBRA {
  id <<key>>
  numero_uc
  endereco_instalacao {
    logradouro
    numero
    bairro
    cidade
    uf
  }
  tipo_ligacao
  data_contrato
  valor_contrato
  potencia_kwp <<derived>>
}

relationship CONTRATA {
}

relationship RESPONSAVEL_POR {
}

relationship EXECUTA {
}

relationship CONECTA {
}

relationship COMPOE {
}

relationship FABRICA {
}

relationship UTILIZA {
  quantidade
  valor_unitario
}

relationship PASSA_POR {
  data_prevista
  data_inicio
  data_conclusao
}

' Generalização / especialização
PESSOA =>= d { CLIENTE, ENGENHEIRO, COLABORADOR }

' Relacionamentos
CLIENTE -(1,1)- CONTRATA
CONTRATA -(0,N)- OBRA

ENGENHEIRO -(1,1)- RESPONSAVEL_POR
RESPONSAVEL_POR -(0,N)- OBRA

EQUIPE -(0,N)- EXECUTA
EXECUTA -(0,N)- OBRA

CONCESSIONARIA -(1,1)- CONECTA
CONECTA -(0,N)- OBRA

EQUIPE -(1,1)- COMPOE
COMPOE -(2,N)- COLABORADOR

FABRICANTE -(1,1)- FABRICA
FABRICA -(0,N)- EQUIPAMENTO

OBRA -(0,N)- UTILIZA
UTILIZA -(0,N)- EQUIPAMENTO

OBRA -(0,N)- PASSA_POR
PASSA_POR -(0,N)- ETAPA

@endchen
