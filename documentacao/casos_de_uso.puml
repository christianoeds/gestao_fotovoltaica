@startuml casos_de_uso
' Diagrama de casos de uso: Gestão Fotovoltaica
' Para gerar a imagem: plugin PlantUML do PhpStorm ou https://www.plantuml.com/plantuml

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Comercial" as comercial
actor "Engenheiro" as engenheiro
actor "Diretoria" as diretoria

rectangle "Sistema de Gestão Fotovoltaica" {
  usecase "UC01 - Manter clientes" as UC01
  usecase "UC02 - Manter obras" as UC02
  usecase "UC10 - Consultar detalhes da obra" as UC10
  usecase "UC08 - Registrar andamento\nda obra" as UC08
  usecase "UC09 - Registrar equipamentos\nda obra" as UC09

  usecase "UC03 - Manter engenheiros" as UC03
  usecase "UC04 - Manter cidades" as UC04
  usecase "UC05 - Manter concessionárias" as UC05
  usecase "UC06 - Manter fabricantes" as UC06
  usecase "UC07 - Manter equipamentos" as UC07
  usecase "UC11 - Emitir relatórios" as UC11
}

comercial --> UC01
comercial --> UC02
comercial --> UC10

engenheiro --> UC10
engenheiro --> UC08
engenheiro --> UC09

diretoria --> UC10
diretoria --> UC03
diretoria --> UC04
diretoria --> UC05
diretoria --> UC06
diretoria --> UC07
diretoria --> UC11

UC08 .> UC10 : <<extend>>
UC09 .> UC10 : <<extend>>

@enduml
