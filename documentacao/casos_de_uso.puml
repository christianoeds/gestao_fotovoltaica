@startuml casos_de_uso
' Diagrama de casos de uso: Gestão Fotovoltaica
' Para gerar a imagem: plugin PlantUML do PhpStorm ou https://www.plantuml.com/plantuml

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Comercial" as comercial
actor "Engenheiro" as engenheiro
actor "Diretoria" as diretoria

rectangle "Sistema de Gestão Fotovoltaica" {
  usecase "UC01 - Manter clientes" as UC01
  usecase "UC02 - Manter obras" as UC02
  usecase "UC12 - Consultar detalhes da obra" as UC12
  usecase "UC10 - Registrar andamento\ndas etapas" as UC10
  usecase "UC11 - Registrar equipamentos\nda obra" as UC11
  usecase "UC14 - Alocar equipes\nna obra" as UC14

  usecase "UC03 - Manter concessionárias" as UC03
  usecase "UC04 - Manter engenheiros" as UC04
  usecase "UC05 - Manter equipes de instalação" as UC05
  usecase "UC06 - Manter colaboradores" as UC06
  usecase "UC07 - Manter fabricantes" as UC07
  usecase "UC08 - Manter equipamentos" as UC08
  usecase "UC09 - Manter etapas" as UC09
  usecase "UC13 - Emitir relatórios" as UC13
}

comercial --> UC01
comercial --> UC02
comercial --> UC12

engenheiro --> UC12
engenheiro --> UC10
engenheiro --> UC11
engenheiro --> UC14

diretoria --> UC12
diretoria --> UC03
diretoria --> UC04
diretoria --> UC05
diretoria --> UC06
diretoria --> UC07
diretoria --> UC08
diretoria --> UC09
diretoria --> UC13

UC10 .> UC12 : <<extend>>
UC11 .> UC12 : <<extend>>
UC14 .> UC12 : <<extend>>

@enduml
