@startuml modelo_logico
' Modelo lógico (notação pé de galinha): Gestão Fotovoltaica
' Para gerar a imagem: plugin PlantUML do PhpStorm (requer Graphviz).
'
' Legenda:  * = obrigatório (NOT NULL)   PK = chave primária   FK = chave estrangeira   UK = único

hide circle
hide empty methods
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70

entity "cidade" as cidade {
  * id : INT <<PK>>
  --
  * nome : VARCHAR(60) <<UK>>
  * uf : CHAR(2) <<UK>>
}

' ---------- Herança: pessoa e suas especializações ----------

entity "pessoa" as pessoa {
  * id : INT <<PK>>
  --
  * cidade_id : INT <<FK>>
  * categoria : VARCHAR(10)
  * nome : VARCHAR(100)
  * telefone : VARCHAR(11)
    email : VARCHAR(100)
  * logradouro : VARCHAR(100)
  * numero : VARCHAR(10)
  * bairro : VARCHAR(60)
}

entity "cliente" as cliente {
  * id : INT <<PK>>
  --
  * pessoa_id : INT <<FK, UK>>
  * cpfCnpj : VARCHAR(14) <<UK>>
}

entity "engenheiro" as engenheiro {
  * id : INT <<PK>>
  --
  * pessoa_id : INT <<FK, UK>>
  * crea : VARCHAR(20) <<UK>>
}

' ---------- Demais tabelas ----------

entity "concessionaria" as concessionaria {
  * id : INT <<PK>>
  --
  * nome : VARCHAR(100)
  * sigla : VARCHAR(20) <<UK>>
  * uf : CHAR(2)
}

entity "obra" as obra {
  * id : INT <<PK>>
  --
  * cliente_id : INT <<FK>>
  * engenheiro_id : INT <<FK>>
  * concessionaria_id : INT <<FK>>
  * cidade_id : INT <<FK>>
  * numeroUc : VARCHAR(20)
  * logradouro : VARCHAR(100)
  * numero : VARCHAR(10)
  * bairro : VARCHAR(60)
  * tipoLigacao : VARCHAR(10)
  * dataContrato : DATE
  * valorContrato : DECIMAL(12,2)
    dataProtocolo : DATE
    dataAprovacao : DATE
  * dataPrevista : DATE
    dataConclusao : DATE
}

entity "fabricante" as fabricante {
  * id : INT <<PK>>
  --
  * nome : VARCHAR(60) <<UK>>
  * paisOrigem : VARCHAR(60)
}

entity "equipamento" as equipamento {
  * id : INT <<PK>>
  --
  * fabricante_id : INT <<FK>>
  * tipo : VARCHAR(20)
  * modelo : VARCHAR(100)
    potenciaW : INT
  * precoAtual : DECIMAL(10,2)
  * garantiaAnos : INT
}

entity "obra_equipamento" as obra_equipamento {
  * obra_id : INT <<PK, FK>>
  * equipamento_id : INT <<PK, FK>>
  --
  * quantidade : INT
  * valorUnitario : DECIMAL(10,2)
}

' Herança (1:1 opcional do lado da especialização)
pessoa ||--o| cliente
pessoa ||--o| engenheiro

' Relacionamentos
cidade ||--o{ pessoa
cidade ||--o{ obra

cliente        ||--o{ obra
engenheiro     ||--o{ obra
concessionaria ||--o{ obra

fabricante  ||--o{ equipamento
obra        ||--o{ obra_equipamento
equipamento ||--o{ obra_equipamento

@enduml
